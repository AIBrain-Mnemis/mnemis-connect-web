{
  "name": "mnemis-connect-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "concurrently -k -n mock,web -c blue,green \"npm:dev:mock\" \"npm:dev:web\"",
    "dev:mock": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tools/mock-server.mjs",
    "dev:web": "cross-env VITE_API_BASE_URL=http://localhost:8787 vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "mock": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tools/mock-server.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "aegis-web-sdk": "^1.35.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^23.7.0",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^13.5.0",
    "react-router-dom": "^6.20.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "trtc-sdk-v5": "latest",
    "tw-animate-css": "^1.4.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "shadcn": "^4.7.0",
    "typescript": "~5.3.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,html,yml,yaml}": "prettier --write"
  }
}
